<Window x:Class="MiniMaxUsage.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:MiniMaxUsage.App.Controls"
        xmlns:conv="clr-namespace:MiniMaxUsage.App.Converters"
        Title="MiniMax Usage"
        Width="980" Height="680"
        MinWidth="860" MinHeight="600"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize">
    <!-- P2-16 修复:无边框窗口补 WindowChrome —— 恢复边缘缩放抓手,
         并让最大化约束到工作区(不再遮挡任务栏);CaptionHeight=0 保留自绘标题栏拖拽 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <LinearGradientBrush x:Key="WindowBg" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#F0F5FC"/>
            <GradientStop Offset="1" Color="#E8EFF8"/>
        </LinearGradientBrush>
        <!-- P2-13 修复:Freeze 共享 brush 提升渲染性能(免费线程安全 + 减少 GC 压力) -->
        <SolidColorBrush x:Key="NormalColor" Color="#22C55E" po:Freeze="True"/>
        <SolidColorBrush x:Key="WarningColor" Color="#F59E0B" po:Freeze="True"/>
        <SolidColorBrush x:Key="CriticalColor" Color="#EF4444" po:Freeze="True"/>

        <!-- P1-1 + P1-9 修复:严重度→刷色、字符串非空→可见性、bool→取反（用于 IsEnabled） -->
        <conv:SeverityToBrushConverter x:Key="SeverityToBrushConverter"/>
        <!-- P0-1 修复:圆环强调色按规范 §7.1 独立映射(5h 蓝/周紫,警告橙,危急红) -->
        <conv:RingAccentConverter x:Key="RingAccentConverter"/>
        <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter"/>
        <conv:BoolNegationConverter x:Key="BoolNegationConverter"/>

        <Style x:Key="TitleButton" TargetType="Button">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- P1-8 + N 修复:RangeButton 用 Tag 携带选中态(bool),DataTrigger Value="True" 严格匹配
             避免 UpdateRangeButtons 用 ClearValue 把硬编码 local value 吞掉 -->
        <Style x:Key="RangeButton" TargetType="Button">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="#EAF2FF"/>
                    <Setter Property="Foreground" Value="#2563EB"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InfoCard" TargetType="Border">
            <Setter Property="Background" Value="#F5F8FC"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="18" Background="{StaticResource WindowBg}" BorderBrush="#FFFFFF" BorderThickness="1">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0">
                    <Button Style="{StaticResource TitleButton}" Background="#FB7185" Click="Close_Click"/>
                    <Button Style="{StaticResource TitleButton}" Background="#FBBF24" Click="Minimize_Click"/>
                    <Button Style="{StaticResource TitleButton}" Background="#4ADE80" Click="Maximize_Click"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="MiniMax Usage" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </Grid>

            <Grid Grid.Row="1" Margin="20,0,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="额度使用详情" FontSize="22" FontWeight="700" Foreground="#172033"/>
                        <TextBlock Text="{Binding Plan}" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- P1-9 修复:StatusText 的颜色由 StatusSeverity 决定,通过转换器映射 -->
                        <TextBlock Text="{Binding StatusText}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"
                                   Foreground="{Binding StatusSeverity, Converter={StaticResource SeverityToBrushConverter}}"/>
                        <!-- P1-9 修复:刷新按钮在刷新中置灰(IsRefreshing) -->
                        <Button x:Name="RefreshButton" Content="↻ 刷新数据" FontSize="11" Foreground="#2563EB" Background="#EAF2FF" BorderThickness="0" Padding="10,6" Cursor="Hand" Click="Refresh_Click"
                                IsEnabled="{Binding IsRefreshing, Converter={StaticResource BoolNegationConverter}}"/>
                    </StackPanel>
                </Grid>

                <!-- P1-1 修复:用 StringNotEmptyToVisibility 转换器决定 Border 可见性 -->
                <Border Grid.Row="1" Background="#FEF2F2" CornerRadius="10" Padding="10,6" Margin="0,10,0,0"
                        BorderBrush="#FECACA" BorderThickness="1"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" FontSize="11" Foreground="#DC2626"/>
                </Border>

                <ScrollViewer Grid.Row="2" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.55*"/>
                                <ColumnDefinition Width="0.45*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="15" Padding="15" BorderBrush="#E1E8F2" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="当前额度" FontSize="14" FontWeight="700" Foreground="#172033"/>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                            <!-- P0-1 修复:Normal 态 5 小时环为规范蓝(#2583F7),Warning/Critical 才切换橙/红 -->
                                            <controls:CircularGauge Value="{Binding FiveHourPercent}" Width="110" Height="110" Caption=""
                                                AccentBrush="{Binding FiveHourSeverity, Converter={StaticResource RingAccentConverter}, ConverterParameter=5h}"/>
                                            <TextBlock Text="5 小时剩余" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                            <!-- P0-1 修复:Normal 态周环为规范紫(#8B5CF6) -->
                                            <controls:CircularGauge Value="{Binding WeeklyPercent}" Width="110" Height="110" Caption=""
                                                AccentBrush="{Binding WeeklySeverity, Converter={StaticResource RingAccentConverter}, ConverterParameter=weekly}"/>
                                            <TextBlock Text="本周剩余" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                <Border Style="{StaticResource InfoCard}">
                                    <StackPanel>
                                        <TextBlock Text="5 小时窗口重置" FontSize="10" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding FiveHourResetText}" FontSize="13" FontWeight="600" Foreground="#172033"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InfoCard}">
                                    <StackPanel>
                                        <TextBlock Text="本周额度重置" FontSize="10" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding WeeklyResetText}" FontSize="13" FontWeight="600" Foreground="#172033"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InfoCard}">
                                    <StackPanel>
                                        <TextBlock Text="最后更新" FontSize="10" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding LastUpdatedText}" FontSize="13" FontWeight="600" Foreground="#172033"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="15" Padding="15" BorderBrush="#E1E8F2" BorderThickness="1" Margin="0,14,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="剩余额度趋势" FontSize="14" FontWeight="700" Foreground="#172033"/>
                                        <TextBlock Text="百分比升高表示额度已重置" FontSize="10" Foreground="#64748B"/>
                                    </StackPanel>
                                    <StackPanel x:Name="RangeButtons" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- P1-8 + N 修复:Tag 直接绑 DataContext(VM)的 IsRange* bool 属性,
                                             DataTrigger Value="True" 与 bool 严格匹配 -->
                                        <Button x:Name="Range24hButton" Content="24小时" Style="{StaticResource RangeButton}" Click="Range24h_Click" Tag="{Binding IsRange24h}"/>
                                        <Button x:Name="Range7dButton" Content="7天" Style="{StaticResource RangeButton}" Click="Range7d_Click" Tag="{Binding IsRange7d}"/>
                                        <Button x:Name="Range30dButton" Content="30天" Style="{StaticResource RangeButton}" Click="Range30d_Click" Tag="{Binding IsRange30d}"/>
                                    </StackPanel>
                                </Grid>
                                <controls:TrendChart x:Name="ChartControl" Height="200" Margin="0,10,0,0"
                                                     FiveHourSegments="{Binding FiveHourSegments}"
                                                     WeeklySegments="{Binding WeeklySegments}"
                                                     AxisStart="{Binding AxisStart}"
                                                     AxisEnd="{Binding AxisEnd}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                        <Rectangle Width="10" Height="3" Fill="#2583F7" VerticalAlignment="Center" RadiusX="2" RadiusY="2"/>
                                        <TextBlock Text="5 小时剩余" FontSize="10" Foreground="#64748B" Margin="4,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle Width="10" Height="3" Fill="#8B5CF6" VerticalAlignment="Center" RadiusX="2" RadiusY="2"/>
                                        <TextBlock Text="本周剩余" FontSize="10" Foreground="#64748B" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="#F8FAFC" CornerRadius="10" Padding="12,8" Margin="0,10,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
                            <TextBlock Text="这是本机定时记录的「剩余额度变化」，不是服务商提供的精确 Token 消耗明细。" FontSize="10" Foreground="#64748B" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>